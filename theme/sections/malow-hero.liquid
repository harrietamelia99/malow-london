{%- comment -%}
  MALOW Hero slideshow
  - Add "Slide" blocks (image or video) and/or "Portrait trio" blocks (3 portrait videos/images side by side on desktop)
  - Each slide can have a separate mobile image/video (e.g. a portrait video on mobile, landscape on desktop)
  - Autoplays, slides across, loops; videos are muted, looping and play inline
  - With no blocks it falls back to the original single hero image
{%- endcomment -%}

{%- liquid
  assign slide_count = section.blocks.size
  assign interval = section.settings.interval | times: 1000
-%}

<section
  class="hero hero--slideshow hero--mobile-{{ section.settings.mobile_shape }}"
  aria-label="Hero banner"
  aria-roledescription="carousel"
  data-malow-slideshow
  data-interval="{{ interval }}"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <div class="hero__card-wrap">
    <div class="hero__image-card">
      {%- render 'malow-black-friday', part: 'ribbon' -%}

      {%- if slide_count > 0 -%}
        <div class="hero-slides__track" data-track>
          {%- for block in section.blocks -%}
            {%- assign slide_label = 'Slide ' | append: forloop.index | append: ' of ' | append: slide_count -%}
            <div
              class="hero-slide hero-slide--{{ block.type }}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ slide_label }}"
              data-slide
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="hero-slide__link" aria-label="{{ block.settings.link_label | default: 'Shop now' | escape }}"></a>
              {%- endif -%}

              {%- case block.type -%}
                {%- when 'slide' -%}
                  {%- liquid
                    assign has_mobile = false
                    if block.settings.mobile_video != blank or block.settings.mobile_image != blank
                      assign has_mobile = true
                    endif
                    assign eager = false
                    if forloop.first
                      assign eager = true
                    endif
                  -%}
                  <div class="hero-slide__media{% if has_mobile %} hero-slide__media--desktop{% endif %}">
                    {%- render 'malow-hero-media', video: block.settings.video, image: block.settings.image, eager: eager, alt: block.settings.alt, position: block.settings.position -%}
                  </div>
                  {%- if has_mobile -%}
                    <div class="hero-slide__media hero-slide__media--mobile">
                      {%- render 'malow-hero-media', video: block.settings.mobile_video, image: block.settings.mobile_image, eager: eager, alt: block.settings.alt, position: 'center' -%}
                    </div>
                  {%- endif -%}

                {%- when 'trio' -%}
                  {%- liquid
                    assign has_third = false
                    if block.settings.video_3 != blank or block.settings.image_3 != blank
                      assign has_third = true
                    endif
                  -%}
                  {%- assign mobile_item = block.settings.mobile_item | default: '1' -%}
                  <div class="hero-trio{% unless has_third %} hero-trio--pair{% endunless %} hero-trio--mobile-{{ mobile_item }}">
                    <div class="hero-trio__item">
                      {%- render 'malow-hero-media', video: block.settings.video_1, image: block.settings.image_1, eager: forloop.first, alt: block.settings.alt, position: 'center' -%}
                    </div>
                    <div class="hero-trio__item">
                      {%- render 'malow-hero-media', video: block.settings.video_2, image: block.settings.image_2, eager: false, alt: block.settings.alt, position: 'center' -%}
                    </div>
                    {%- if has_third -%}
                      <div class="hero-trio__item">
                        {%- render 'malow-hero-media', video: block.settings.video_3, image: block.settings.image_3, eager: false, alt: block.settings.alt, position: 'center' -%}
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if slide_count > 1 -%}
          <button type="button" class="hero-slides__arrow hero-slides__arrow--prev" data-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="hero-slides__arrow hero-slides__arrow--next" data-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="hero-slides__dots" role="tablist" aria-label="Choose slide">
            {%- for block in section.blocks -%}
              <button type="button" class="hero-slides__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" role="tab" aria-label="Go to slide {{ forloop.index }}"{% if forloop.first %} aria-selected="true"{% endif %}></button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- else -%}
        {%- comment -%} Fallback: original single hero image (used until slides are added) {%- endcomment -%}
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 2400 }}"
            srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ section.settings.image.alt | default: 'MALOW London hero image' | escape }}"
            class="hero__image-card-img"
            loading="eager"
            fetchpriority="high">
        {%- else -%}
          <img
            src="{{ 'hero-banner.png' | asset_url }}"
            alt="MALOW London heels in cream, pink and taupe"
            class="hero__image-card-img"
            loading="eager"
            fetchpriority="high">
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_badge -%}
        <div class="hero__overlay">
          <div class="hero__badge-outer">
            <style>
              .hero__badge-wrap {
                background-image: url('{{ "malow-website-hero.svg" | asset_url }}') !important;
              }
            </style>
            <div class="hero__badge-wrap" aria-hidden="true"></div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-malow-slideshow')) return;
    var track = root.querySelector('[data-track]');
    if (!track) return;
    var slides = Array.prototype.slice.call(track.querySelectorAll('[data-slide]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot]'));
    var count = slides.length;
    var index = 0;
    var timer = null;
    var interval = parseInt(root.getAttribute('data-interval'), 10) || 5000;
    var autoplay = root.getAttribute('data-autoplay') === 'true';
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function playVisibleVideos() {
      slides.forEach(function (slide, i) {
        slide.querySelectorAll('video').forEach(function (v) {
          v.muted = true;
          if (i === index && v.offsetParent !== null) {
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          } else {
            v.pause();
          }
        });
      });
    }

    function goTo(i) {
      index = (i + count) % count;
      track.style.transform = 'translateX(' + (-100 * index) + '%)';
      slides.forEach(function (s, n) { s.setAttribute('aria-hidden', n === index ? 'false' : 'true'); });
      dots.forEach(function (d, n) {
        d.classList.toggle('is-active', n === index);
        if (n === index) { d.setAttribute('aria-selected', 'true'); } else { d.removeAttribute('aria-selected'); }
      });
      playVisibleVideos();
    }

    function start() {
      stop();
      if (autoplay && !reduceMotion && count > 1) {
        timer = setInterval(function () { goTo(index + 1); }, interval);
      }
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    if (prev) prev.addEventListener('click', function () { goTo(index - 1); start(); });
    if (next) next.addEventListener('click', function () { goTo(index + 1); start(); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(parseInt(d.getAttribute('data-dot'), 10)); start(); });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    // Swipe on touch screens
    var startX = null;
    track.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; stop(); }, { passive: true });
    track.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) { goTo(dx < 0 ? index + 1 : index - 1); }
      startX = null;
      start();
    });

    // Pause when the tab is hidden
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { stop(); } else { start(); }
    });

    // Theme editor: jump to the slide being edited
    document.addEventListener('shopify:block:select', function (e) {
      var n = slides.indexOf(e.target);
      if (n > -1) { goTo(n); stop(); }
    });
    document.addEventListener('shopify:block:deselect', start);

    window.addEventListener('resize', playVisibleVideos);
    goTo(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "MALOW Hero",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Time on each slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "mobile_shape",
      "label": "Banner shape on mobile",
      "options": [
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "portrait", "label": "Portrait (4:5) - best for portrait videos" }
      ],
      "default": "landscape"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback hero image",
      "info": "Only shows if there are no slides. Recommended: 2400 x 960px"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show MALOW badge over the banner",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Short MP4, 5-10 seconds. Plays muted on a loop. Used instead of the image if both are set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 2400 x 960px (landscape)"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Focus point",
          "options": [
            { "value": "center", "label": "Centre" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "header",
          "content": "Mobile (optional)"
        },
        {
          "type": "paragraph",
          "content": "Add a separate video or image for phones, e.g. a portrait version. Leave empty to use the desktop one."
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Link (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link description (for screen readers)",
          "default": "Shop now"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "MALOW London heels"
        }
      ]
    },
    {
      "type": "trio",
      "name": "Side-by-side (2 or 3)",
      "settings": [
        {
          "type": "paragraph",
          "content": "Two or three videos or images side by side on desktop, so portrait and square clips don't get cropped. Leave item 3 empty for a pair. On mobile one of them shows full width (choose which below)."
        },
        { "type": "video", "id": "video_1", "label": "Video 1" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1 (if no video)" },
        { "type": "video", "id": "video_2", "label": "Video 2" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2 (if no video)" },
        { "type": "video", "id": "video_3", "label": "Video 3 (optional)" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3 (if no video)" },
        {
          "type": "select",
          "id": "mobile_item",
          "label": "Which one to show on mobile",
          "options": [
            { "value": "1", "label": "Item 1" },
            { "value": "2", "label": "Item 2" },
            { "value": "3", "label": "Item 3" }
          ],
          "default": "1",
          "info": "Tip: pick a video so the slide still moves on phones."
        },
        { "type": "url", "id": "link", "label": "Slide link (optional)" },
        { "type": "text", "id": "link_label", "label": "Link description (for screen readers)", "default": "Shop now" },
        { "type": "text", "id": "alt", "label": "Image description", "default": "MALOW London heels" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MALOW Hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
